# Copy to .env (or set in your shell). Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
MODEL_PATH=models/emotion_model.keras
HOST=127.0.0.1
PORT=5000
# The EfficientNet model must be calibrated before setting a production threshold.
UNSURE_BELOW=0.0

# Optional LLM reviewer for "Write your own check-in" feedback. Off by default: when set, the
# learner's message text (and nothing else) is sent to this provider. Leave blank to keep the
# offline rule-based reviewer, which runs on this app's server and sends nothing to an external
# AI provider. Provider retention in LLM mode depends on that provider's API terms.
MOSAIC_LLM_PROVIDER=
MOSAIC_LLM_API_KEY=
# MOSAIC_LLM_MODEL=claude-haiku-4-5-20251001
